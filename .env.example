# Copy to .env for local development. Every variable is validated in src/main/env.ts,
# so a missing or malformed value fails at startup rather than on the first request.

# Selects which DATABASE_URI_* takes precedence. One of: dev | production
ENV=dev

# HTTP port. Integer between 1 and 65535.
PORT=3000

# Shared fallback connection URI, used when no env-specific URI is set.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"

# Optional env-specific overrides. Both must include an explicit port.
# DATABASE_URI_DEV="postgres://postgres:postgres@localhost:5432/firewall_dev"
# DATABASE_URI_PRODUCTION="postgres://user:password@db.internal:5432/firewall"

# Fixed wait, in milliseconds, between database connection attempts during the
# stop-and-wait startup handshake. Defaults to 2000 when omitted.
DB_CONNECTION_INTERVAL=2000
