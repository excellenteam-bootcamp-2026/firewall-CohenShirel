# Environment: dev | production
ENV=dev

PORT=3000

# Fallback Database URI
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"

# Env-specific overrides (must include explicit port)
# DATABASE_URI_DEV="postgres://postgres:postgres@localhost:5432/firewall_dev"
# DATABASE_URI_PRODUCTION="postgres://user:password@db.internal:5432/firewall"

# DB connection retry interval in ms
DB_CONNECTION_INTERVAL=2000


